PORT=3000

# Em produção (NODE_ENV=production), o chat em /dev fica desligado salvo definires:
# JOANA_DEV_CHAT=1

# Pasta persistente na cloud (opcional). Se não definires, usa ./data na raiz do projeto.
# JOANA_DATA_DIR=/var/joana-data

# WhatsApp Cloud API
WHATSAPP_PROVIDER=cloud
WHATSAPP_TOKEN=coloca_o_token_aqui
WHATSAPP_PHONE_NUMBER_ID=coloca_o_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=joana-local-dev

# App Secret da app Meta (Basic > App Secret) — obrigatório em produção para validar X-Hub-Signature-256 no POST /webhook
# WHATSAPP_APP_SECRET=

# Twilio WhatsApp, se preferires usar Twilio
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=coloca_o_sid_aqui
# TWILIO_AUTH_TOKEN=coloca_o_auth_token_aqui
# TWILIO_FROM=whatsapp:+14155238886

# Para transcrever áudios recebidos no WhatsApp
OPENAI_API_KEY=coloca_a_chave_aqui

# Depois de perguntar pelo horário, assume "sem horário" se não houver resposta neste tempo
PENDING_TIME_REPLY_MS=900000
